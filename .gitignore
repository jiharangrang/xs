# 로컬 가상환경과 캐시
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
MUJOCO_LOG.TXT

# 이 컴퓨터에서 선택한 모터 통신 포트
.local/motor_port.json
.local/last_pose.json
.local/last_pose.tmp

# 실행마다 자동 저장되는 모터 진단 로그
logs/motors/

# 실행 출력은 제외하고 공통 시작 자세만 공유해요.
outputs/*
!outputs/stage1_observation_pose.json

# macOS 자동 생성 파일
.DS_Store

# 로컬 환경 변수
.env
.env.*
!.env.example
